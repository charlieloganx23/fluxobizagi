# Variáveis de Ambiente para Netlify Functions

# GitHub Personal Access Token
# Necessário para fazer commits via API
# Permissões necessárias: repo (full control)
# Como criar: https://github.com/settings/tokens/new
GITHUB_TOKEN=ghp_seu_token_aqui

# Senha de administrador (opcional - para produção use Netlify Identity)
ADMIN_PASSWORD=sua_senha_segura_aqui
